# Copy to .env for `docker compose up`. Local development reads api/.env instead (see README).

# --- Database (compose builds DATABASE_URL from these) ---
POSTGRES_DB=lightdesign
POSTGRES_USER=lightdesign
# URL-safe characters only: it is embedded in the connection string.
POSTGRES_PASSWORD=

# --- Sign-in ---
# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false
# Only needed if the web app is served from a different origin than the API:
# CORS_ORIGINS=["https://designs.example.com"]

# --- Detection ---
# mock = placeholder regions, no key, no spend. fal = SAM 3 on fal.ai (pay-as-you-go).
SEGMENTATION_PROVIDER=fal
# Customer photos are sent as inline base64 data URIs and never uploaded to fal's storage.
FAL_KEY=
FAL_MODEL=fal-ai/sam-3/image
# png | rle — leave as png until `python tests/fal_probe.py` confirms the RLE encoding.
FAL_MASK_FORMAT=png
FAL_MAX_MASKS=16
FAL_TIMEOUT=120
FAL_CONCURRENCY=4

# Image generation / editing. Used from Milestone 3.
GOOGLE_API_KEY=

MAX_UPLOAD_MB=25
MAX_IMAGE_EDGE=6000
DETECT_MAX_EDGE=1280
WEB_PORT=80

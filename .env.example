# Copy this file to .env (or just edit .env) and restart the server. The app loads .env itself.

# SAM 3 on fal.ai: https://fal.ai/models/fal-ai/sam-3/image
# Only this key is required. Create one at https://fal.ai/dashboard/keys
FAL_KEY=

# Endpoint. The default is fal's synchronous endpoint; the queue endpoint
# https://queue.fal.run/fal-ai/sam-3/image also works (the app polls it).
SAM_API_URL=https://fal.run/fal-ai/sam-3/image

# Concept to segment. "roof" gives the roof outline; "house" gives the whole silhouette.
SAM_TEXT_PROMPT=roof

# How many candidate masks to ask SAM 3 for; the ones containing your point prompt are merged.
SAM_MAX_MASKS=12

# Seconds to wait for the API.
SAM_API_TIMEOUT=90

# Accounts (optional). Leave AUTH_SECRET empty to generate one into data/secret.key.
AUTH_SECRET=
ALLOW_SIGNUP=true
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000

# Copy to .env for `docker compose up`. Local development reads api/.env instead (see README).

# --- Database (compose builds DATABASE_URL from these) ---
POSTGRES_DB=lightdesign
POSTGRES_USER=lightdesign
# URL-safe characters only: it is embedded in the connection string.
POSTGRES_PASSWORD=

# --- Sign-in ---
# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false
# Only needed if the web app is served from a different origin than the API:
# CORS_ORIGINS=["https://designs.example.com"]

# --- Detection ---
# sam preserves the existing roof pipeline. v3_sol replaces roof detection only.
ROOFLINE_DETECTOR=sam
# Customer-owned OpenRouter key, used by the V3 roof detector and the instruction reader.
# Photos go to OpenRouter and its selected model provider.
OPENROUTER_API_KEY=
ROOFLINE_MODEL=openai/gpt-6-sol
ROOFLINE_REASONING=low
ROOFLINE_TIMEOUT=360
# mock = placeholder regions, no key, no spend. fal = SAM 3 on fal.ai (pay-as-you-go).
SEGMENTATION_PROVIDER=fal
# Customer photos are sent as inline base64 data URIs and never uploaded to fal's storage.
FAL_KEY=
FAL_MODEL=fal-ai/sam-3/image
# png | rle — leave as png until `python tests/fal_probe.py` confirms the RLE encoding.
FAL_MASK_FORMAT=png
FAL_MAX_MASKS=16
FAL_TIMEOUT=120
FAL_CONCURRENCY=4

# --- Reading the instruction ---
# How a typed instruction becomes requests. llm asks the model below and falls back to the
# fixed rules whenever it cannot answer; rules is offline, free and deterministic. Either way
# the app works -- the confirmation screen says which one read it. Uses OPENROUTER_API_KEY.
INSTRUCTION_PARSER=llm
PARSER_MODEL=openai/gpt-6-sol
PARSER_TIMEOUT=20

# Image generation / editing. Used from Milestone 3.
GOOGLE_API_KEY=

MAX_UPLOAD_MB=25
MAX_IMAGE_EDGE=6000
DETECT_MAX_EDGE=1280
WEB_PORT=80

# Roof line extraction: hybrid (original) | partition (reference method).
EDGE_EXTRACTOR=partition
# partition engine: reference (the roof-detection project's own code, exact) | port (services/partition.py)
PARTITION_ENGINE=reference
# The hybrid-era "roof meets wall" relabel removes real hips on partition output.
PARTITION_JUNCTIONS=false
# true: roof lines only on the house being quoted; neighbours' planes get no lines and do not
# decide the vanishing points. The editor's House tool taps a plane in or out. See README.
TARGET_HOUSE_ONLY=false
